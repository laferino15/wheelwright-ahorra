<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="merchant_home_link" inherit_id="wheelwright_ahorra.home_wheelwright"><xpath expr="//div[hasclass('wah-local-strip')]" position="before"><section class="wah-seller-invite"><div class="container"><div><span class="wah-eyebrow wah-green">UN LUGAR PARA TU NEGOCIO</span><h2>¿Tenés un local en Wheelwright?</h2><p>Sumá tu comercio y acercá tus productos a más vecinos.</p></div><a href="/vender" class="wah-button wah-button-green">Quiero sumar mi local <span aria-hidden="true">↗</span></a></div></section></xpath></template>
 <template id="merchant_portal_entry" inherit_id="portal.portal_my_home"><xpath expr="//div[@id='portal_common_category']" position="inside"><t t-call="portal.portal_docs_entry"><t t-set="title">Mi comercio</t><t t-set="text">Registrá tu local y administrá tus productos en wheel-ahorra.</t><t t-set="url" t-value="'/mi-comercio'"/><t t-set="config_card" t-value="True"/></t></xpath></template>

 <template id="merchant_landing" name="Vender en wheel-ahorra"><t t-call="website.layout"><div id="wrap" class="wah-merchant"><div class="container py-5"><span class="wah-eyebrow wah-green">CRECÉ EN TU CIUDAD</span><h1>Tu local, también en wheel-ahorra.</h1><p class="lead">Mostrá tus productos a los vecinos de Wheelwright desde un solo lugar.</p><div class="row g-4 my-4"><div class="col-md-4"><h3>1. Registrá tu local</h3><p>Contanos qué vendés, dónde estás y cómo contactarte.</p></div><div class="col-md-4"><h3>2. Cargá tus productos</h3><p>Una vez aprobado el local, agregá fotos, presentaciones y precios.</p></div><div class="col-md-4"><h3>3. Enviá a revisión</h3><p>La administración revisa tus productos antes de publicarlos en la tienda.</p></div></div><a href="/mi-comercio" class="btn btn-success me-2">Entrar a mi comercio</a><a href="/web/signup?redirect=/mi-comercio/registro" class="btn btn-outline-success">Crear mi cuenta</a><p class="text-muted mt-3">Tu cuenta también sirve para comprar y consultar tus pedidos.</p></div></div></t></template>

 <template id="merchant_register" name="Registro del local"><t t-call="portal.portal_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant py-4"><a href="/mi-comercio" class="wah-text-link">← Mi comercio</a><h1 class="mt-3">Registrá tu local</h1><p>La administración revisará los datos antes de habilitar la venta. Si editás un local aprobado, volverá a revisión.</p><div t-if="error" role="alert" class="alert alert-danger" t-esc="error"/><form method="post" action="/mi-comercio/registro" enctype="multipart/form-data" class="wah-merchant-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3">
  <div class="col-md-6"><label for="merchant_name" class="form-label">Nombre del local</label><input id="merchant_name" name="name" required="required" maxlength="200" class="form-control" t-att-value="values.get('name', store.name if store else '')"/></div>
  <div class="col-md-6"><label for="merchant_category" class="form-label">Rubro</label><select id="merchant_category" name="category_id" required="required" class="form-select"><option value="">Elegí un rubro</option><option t-foreach="categories" t-as="category" t-att-value="category.id" t-att-selected="str(category.id) == str(values.get('category_id', store.category_id.id if store else ''))" t-esc="category.name"/></select></div>
  <div class="col-md-6"><label for="merchant_street" class="form-label">Dirección del local en Wheelwright</label><input id="merchant_street" name="street" required="required" maxlength="200" class="form-control" t-att-value="values.get('street', store.street if store else '')"/></div>
  <div class="col-md-6"><label for="merchant_phone" class="form-label">Teléfono / WhatsApp</label><input id="merchant_phone" name="phone" type="tel" required="required" maxlength="200" class="form-control" t-att-value="values.get('phone', store.phone if store else '')"/></div>
  <div class="col-md-6"><label for="merchant_hours" class="form-label">Horarios de atención</label><input id="merchant_hours" name="hours" maxlength="200" class="form-control" t-att-value="values.get('hours', store.hours if store else '')" placeholder="Por ejemplo: lunes a sábado de 8 a 13"/></div>
  <div class="col-md-6"><label for="merchant_logo" class="form-label">Logo (opcional)</label><img t-if="logo_src" t-att-src="logo_src" alt="Logo actual del local" class="d-block mb-2 rounded" style="width:100px;height:100px;object-fit:contain"/><input id="merchant_logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/><small>JPG, PNG o WebP. Hasta 5 MB.</small></div>
  <div class="col-12"><label for="merchant_description" class="form-label">Contanos sobre tu local</label><textarea id="merchant_description" name="description" rows="3" maxlength="2000" class="form-control"><t t-esc="values.get('description', store.description if store else '')"/></textarea></div>
 </div><button class="btn btn-success mt-4" type="submit">Enviar local a revisión</button></form></div></t></template>

 <template id="merchant_dashboard" name="Mi comercio"><t t-call="portal.portal_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant py-4"><div class="d-flex flex-wrap gap-3 justify-content-between align-items-center"><div><span class="wah-eyebrow wah-green">MI COMERCIO</span><h1 t-esc="store.name"/><span class="badge bg-secondary" t-att-data-state="store.state" t-field="store.state"/></div><a href="/mi-comercio/registro" class="btn btn-outline-success">Editar datos del local</a></div><div t-if="notice" class="alert alert-success mt-3" role="status" t-esc="notice"/><div t-if="store.review_notes" class="alert alert-info mt-3" t-esc="store.review_notes"/><div t-if="store.state != 'approved'" class="wah-merchant-form mt-4"><h3>Tu local está en revisión</h3><p>Cuando la administración lo apruebe, vas a poder cargar tus productos. Podés seguir usando tu cuenta para comprar.</p><a href="/shop" class="wah-text-link">Ir a la tienda →</a></div>
  <t t-else=""><div class="d-flex align-items-center justify-content-between gap-3 mt-5 mb-3"><h2>Mis productos</h2><a href="/mi-comercio/productos/nuevo" class="btn btn-success">Agregar producto</a></div><p class="text-muted">Los productos se publican después de la revisión. Si editás un producto aprobado, se retira de la tienda hasta que vuelva a aprobarse.</p><div t-if="not products" class="wah-merchant-form"><h3>Empezá con tu primer producto</h3><p>Prepará una foto, el nombre, la presentación y el precio final al cliente.</p></div><div t-else="" class="table-responsive"><table class="table align-middle"><thead><tr><th>Producto</th><th>Presentación</th><th>Precio final</th><th>Estado</th><th/></tr></thead><tbody><tr t-foreach="products" t-as="product"><td><strong t-esc="product.name"/><small t-if="product.review_notes" class="d-block text-muted" t-esc="product.review_notes"/></td><td t-esc="product.presentation"/><td><span t-field="product.price"/></td><td><span class="wah-status" t-att-data-state="product.state" t-field="product.state"/><small t-if="not product.available" class="d-block">Sin disponibilidad</small></td><td><a t-att-href="'/mi-comercio/productos/%s' % product.id" class="btn btn-sm btn-outline-success">Editar</a><form t-if="product.state in ('draft','rejected')" t-att-action="'/mi-comercio/productos/%s/enviar' % product.id" method="post" class="d-inline"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="btn btn-sm btn-success ms-1">Enviar a revisión</button></form></td></tr></tbody></table></div></t>
 </div></t></template>

 <template id="merchant_product_form" name="Producto de mi comercio"><t t-call="portal.portal_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant py-4"><a href="/mi-comercio" class="wah-text-link">← Mis productos</a><h1 class="mt-3"><t t-if="product">Editar producto</t><t t-else="">Agregar producto</t></h1><p>Local: <strong t-esc="store.name"/>. Podés guardar un borrador para seguir editando o enviar el producto directamente a revisión.</p><div t-if="error" role="alert" class="alert alert-danger" t-esc="error"/><form method="post" enctype="multipart/form-data" t-att-action="'/mi-comercio/productos/%s' % product.id if product else '/mi-comercio/productos/nuevo'" class="wah-merchant-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3">
  <div class="col-md-6"><label for="mp_name" class="form-label">Nombre del producto</label><input id="mp_name" name="name" required="required" maxlength="200" class="form-control" t-att-value="values.get('name', product.name if product else '')"/></div>
  <div class="col-md-6"><label for="mp_category" class="form-label">Categoría</label><select id="mp_category" name="category_id" required="required" class="form-select"><option t-foreach="categories" t-as="category" t-att-value="category.id" t-att-selected="str(category.id) == str(values.get('category_id', product.category_id.id if product else store.category_id.id))" t-esc="category.name"/></select></div>
  <div class="col-md-6"><label for="mp_presentation" class="form-label">Presentación / unidad de venta</label><input id="mp_presentation" name="presentation" required="required" maxlength="200" class="form-control" placeholder="Por ejemplo: bandeja de 500 g, unidad o media docena" t-att-value="values.get('presentation', product.presentation if product else '')"/></div>
  <div class="col-md-6"><label for="mp_price" class="form-label">Precio final al cliente ($)</label><input id="mp_price" name="price" type="number" min="0.01" step="0.01" inputmode="decimal" required="required" class="form-control" t-att-value="values.get('price', product.price if product else '')"/><small>Indicá el importe completo de esa presentación, incluidos los impuestos.</small></div>
  <div class="col-12"><label for="mp_description" class="form-label">Descripción</label><textarea id="mp_description" name="description" maxlength="4000" rows="4" class="form-control"><t t-esc="values.get('description', product.description if product else '')"/></textarea></div>
  <div class="col-12"><label for="mp_image" class="form-label">Imagen del producto</label><img t-if="image_src" t-att-src="image_src" alt="Imagen actual del producto" class="d-block mb-2 rounded" style="width:160px;height:160px;object-fit:contain"/><input id="mp_image" name="image" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/><small>JPG, PNG o WebP, hasta 5 MB. La imagen es necesaria para enviar a revisión. En una edición podés dejar este campo vacío para conservar la imagen.</small></div>
  <div class="col-12"><div class="form-check"><input id="mp_available" name="available" value="1" type="checkbox" class="form-check-input" t-att-checked="values.get('available') == '1' if values else (product.available if product else True)"/><label for="mp_available" class="form-check-label">Disponible para vender</label></div></div>
 </div><div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" name="intent" value="save" class="btn btn-outline-success">Guardar borrador</button><button type="submit" name="intent" value="submit" class="btn btn-success">Enviar a revisión</button></div></form></div></t></template>

 <record id="merchant_list" model="ir.ui.view"><field name="name">wah.merchant.list</field><field name="model">wah.merchant</field><field name="arch" type="xml"><list><field name="name"/><field name="owner_id"/><field name="category_id"/><field name="phone"/><field name="state"/></list></field></record>
 <record id="merchant_form" model="ir.ui.view"><field name="name">wah.merchant.form</field><field name="model">wah.merchant</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Aprobar local" class="btn-primary" invisible="state == 'approved'"/><button name="action_reject" type="object" string="Solicitar cambios / suspender" invisible="state == 'rejected'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="owner_id"/><field name="website_id"/><field name="category_id"/><field name="partner_id"/></group><group><field name="street"/><field name="phone"/><field name="hours"/><field name="logo" widget="image"/></group></group><field name="description"/><field name="review_notes" readonly="0"/><field name="product_ids" readonly="1"><list><field name="name"/><field name="price"/><field name="state"/></list></field></sheet></form></field></record>
 <record id="merchant_product_list" model="ir.ui.view"><field name="name">wah.merchant.product.list</field><field name="model">wah.merchant.product</field><field name="arch" type="xml"><list><field name="merchant_id"/><field name="name"/><field name="presentation"/><field name="currency_id" column_invisible="True"/><field name="price"/><field name="state"/></list></field></record>
 <record id="merchant_product_form_admin" model="ir.ui.view"><field name="name">wah.merchant.product.form</field><field name="model">wah.merchant.product</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Aprobar y publicar" class="btn-primary" invisible="state != 'pending'"/><button name="action_reject" type="object" string="Solicitar cambios" invisible="state == 'rejected'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="merchant_id"/><field name="name"/><field name="category_id"/><field name="presentation"/><field name="currency_id" invisible="1"/><field name="price"/><field name="available"/></group><group><field name="image" widget="image"/><field name="product_tmpl_id"/></group></group><field name="description"/><field name="review_notes" readonly="0"/></sheet></form></field></record>
 <record id="merchant_action" model="ir.actions.act_window"><field name="name">Comercios</field><field name="res_model">wah.merchant</field><field name="view_mode">list,form</field></record>
 <record id="merchant_product_action" model="ir.actions.act_window"><field name="name">Productos de comercios</field><field name="res_model">wah.merchant.product</field><field name="view_mode">list,form</field></record>
 <menuitem id="marketplace_menu" name="wheel-ahorra" groups="product.group_product_manager" sequence="35"/>
 <menuitem id="merchant_menu" name="Comercios" parent="marketplace_menu" action="merchant_action"/>
 <menuitem id="merchant_product_menu" name="Productos para revisar" parent="marketplace_menu" action="merchant_product_action"/>
</odoo>
