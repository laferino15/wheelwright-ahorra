<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="merchant_stock_form" name="Stock y disponibilidad"><t t-call="portal.portal_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant py-4"><a href="/mi-comercio" class="wah-text-link">← Mis productos</a><h1 class="mt-3">Stock y disponibilidad</h1><p><strong t-esc="product.name"/> · <t t-esc="product.presentation"/> · <t t-esc="store.name"/></p><p>Estos ajustes no cambian la aprobación del producto. Indicá cuántas presentaciones podés vender a partir de ahora.</p><div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/><form method="post" t-att-action="'/mi-comercio/productos/%s/stock' % product.id" class="wah-merchant-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="form-check mb-3"><input type="checkbox" id="stock_available" name="available" value="1" class="form-check-input" t-att-checked="values.get('available') == '1' if values else product.available"/><label for="stock_available" class="form-check-label">Habilitado para vender</label></div><div class="form-check mb-3"><input type="checkbox" id="stock_tracking" name="stock_tracking" value="1" class="form-check-input" t-att-checked="values.get('stock_tracking') == '1' if values else product.stock_tracking"/><label for="stock_tracking" class="form-check-label">Controlar la cantidad disponible</label></div><label for="stock_quantity" class="form-label">Cantidad disponible de esta presentación</label><input id="stock_quantity" name="stock_quantity" type="number" min="0" step="0.01" required="required" class="form-control" t-att-value="values.get('stock_quantity', str(product.stock_quantity))"/><p class="small mt-2">Por ejemplo, 10 bandejas de 500 g se cargan como 10. Con control activo y cantidad 0, el producto se muestra agotado. Sin control activo, no se aplica un límite por cantidad.</p><div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-success">Actualizar disponibilidad</button><a href="/mi-comercio" class="btn btn-outline-success">Volver</a></div></form></div></t></template>
 <template id="stock_dashboard" inherit_id="wheelwright_ahorra.merchant_dashboard"><xpath expr="//p[hasclass('text-muted')]" position="replace"><p class="text-muted">Los productos se publican después de la revisión. Editar nombre, precio o presentación requiere una nueva revisión. Desde Ajustar stock podés cambiar la cantidad o pausar la venta sin perder la aprobación.</p></xpath><xpath expr="//thead/tr/th[last()]" position="before"><th>Disponibilidad</th></xpath><xpath expr="//tbody/tr/td[last()]" position="before"><td><span t-if="not product.available" class="wah-status" data-state="cancelled">Venta pausada</span><span t-elif="product.stock_tracking and product.stock_quantity &lt;= 0" class="wah-status" data-state="rejected">Agotado</span><span t-elif="product.stock_tracking"><strong t-field="product.stock_quantity"/> disponibles</span><span t-else="">Sin límite de cantidad</span><a class="d-block wah-text-link mt-2" t-att-href="'/mi-comercio/productos/%s/stock' % product.id">Ajustar stock →</a></td></xpath></template>
 <template id="stock_initial_form" inherit_id="wheelwright_ahorra.merchant_product_form"><xpath expr="//input[@id='mp_available']/../.." position="after"><div class="col-12"><div class="form-check mb-3"><input type="checkbox" id="mp_stock_tracking" name="stock_tracking" value="1" class="form-check-input" t-att-checked="values.get('stock_tracking') == '1' if values else (product.stock_tracking if product else True)"/><label for="mp_stock_tracking" class="form-check-label">Controlar stock por presentación</label></div><label for="mp_stock_quantity" class="form-label">Cantidad disponible para vender</label><input id="mp_stock_quantity" name="stock_quantity" type="number" min="0" step="0.01" class="form-control" t-att-value="values.get('stock_quantity', str(product.stock_quantity if product else 0))"/><small>Indicá cuántas presentaciones podés vender. Con control activo y cantidad 0, aparece agotado. Después podés ajustar el stock desde Mis productos sin reenviar a revisión.</small></div></xpath></template>
 <template id="stock_catalog_badge" inherit_id="website_sale.products_item"><xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="after"><span t-if="product.wah_sold_out" class="badge bg-warning text-dark my-2">Agotado</span></xpath></template>
 <template id="stock_home_badge" inherit_id="wheelwright_ahorra.home_wheelwright"><xpath expr="//a[hasclass('wah-product-name')]" position="after"><span t-if="product.wah_sold_out" class="badge bg-warning text-dark my-2 align-self-start">Agotado</span></xpath></template>
 <template id="stock_product_notice" inherit_id="website_sale.product_title"><xpath expr="//h1" position="after"><p t-if="product.wah_sold_out" class="alert alert-warning mt-3" role="status">Este producto está agotado por el momento.</p></xpath></template>
 <template id="stock_product_cta" inherit_id="website_sale.cta_wrapper"><xpath expr="//a[@id='add_to_cart']" position="attributes"><attribute name="t-attf-class" add="#{'disabled' if product.wah_sold_out else ''}" separator=" "/><attribute name="t-att-aria-disabled">'true' if product.wah_sold_out else None</attribute><attribute name="t-att-tabindex">'-1' if product.wah_sold_out else None</attribute></xpath></template>
 <record id="stock_admin_form" model="ir.ui.view"><field name="name">wah.merchant.product.stock.form</field><field name="model">wah.merchant.product</field><field name="inherit_id" ref="wheelwright_ahorra.merchant_product_form_admin"/><field name="arch" type="xml"><field name="available" position="after"><field name="stock_tracking"/><field name="stock_quantity" invisible="not stock_tracking"/></field></field></record>
 <record id="stock_admin_list" model="ir.ui.view"><field name="name">wah.merchant.product.stock.list</field><field name="model">wah.merchant.product</field><field name="inherit_id" ref="wheelwright_ahorra.merchant_product_list"/><field name="arch" type="xml"><field name="state" position="after"><field name="available"/><field name="stock_tracking"/><field name="stock_quantity"/></field></field></record>
</odoo>
