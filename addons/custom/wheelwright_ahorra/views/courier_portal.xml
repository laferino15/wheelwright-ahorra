<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="courier_account_form" model="ir.ui.view"><field name="name">wah.courier.account.form</field><field name="model">wah.courier</field><field name="inherit_id" ref="wheelwright_ahorra.courier_form"/><field name="arch" type="xml"><xpath expr="//field[@name='phone']" position="after"><field name="user_id" options="{'no_create':True}"/><p class="text-muted">Vinculá la cuenta con la que esta persona entra a wheel-ahorra. Solo verá los pedidos asignados a este repartidor.</p></xpath></field></record>
 <record id="courier_account_list" model="ir.ui.view"><field name="name">wah.courier.account.list</field><field name="model">wah.courier</field><field name="inherit_id" ref="wheelwright_ahorra.courier_list"/><field name="arch" type="xml"><xpath expr="//field[@name='phone']" position="after"><field name="user_id"/></xpath></field></record>
 <template id="courier_portal_navigation" inherit_id="wheelwright_ahorra.marketplace_shell" name="Acceso a Mi reparto">
  <xpath expr="//div[hasclass('wah-account-dropdown')]/a[@href='/mi-comercio']" position="after"><a t-if="request.env['wah.courier'].sudo().search_count([('user_id','=',request.env.uid),('active','=',True)])" href="/mi-reparto">Mi reparto</a></xpath>
 </template>
 <template id="courier_portal_home" inherit_id="portal.portal_my_home" name="Mi reparto en mi cuenta">
  <xpath expr="//div[@id='portal_common_category']" position="inside"><t t-if="request.env['wah.courier'].sudo().search_count([('user_id','=',request.env.uid),('active','=',True)])" t-call="portal.portal_docs_entry"><t t-set="title">Mi reparto</t><t t-set="text">Aceptá recorridos, registrá retiros, entregas y cobros.</t><t t-set="url" t-value="'/mi-reparto'"/><t t-set="config_card" t-value="True"/></t></xpath>
 </template>
 <template id="merchant_pickup_detail" inherit_id="wheelwright_ahorra.merchant_preparation_detail" name="Retiro gestionado por el comercio" priority="1000">
  <xpath expr="//p[hasclass('small') and hasclass('text-muted')]" position="replace"><p class="small text-muted">Gestioná el retiro de tus productos desde acá. Un repartidor entrega y cobra la compra completa; este subtotal no confirma un cobro ni una liquidación.</p></xpath>
  <xpath expr="//p[@t-if=&quot;preparation.state == 'ready'&quot;]" position="replace">
   <section t-if="preparation.state == 'ready'" class="wah-pickup-panel mt-4"><h3>Retiro de tu local</h3>
    <p t-if="not preparation.pickup_requested_at">Cuando los productos estén embalados, solicitá que los retire el repartidor.</p>
    <p t-else="" class="alert alert-success" role="status">Retiro solicitado. Registrá la entrega cuando el repartidor reciba los productos.</p>
    <p t-if="pickup_info and pickup_info['courier']"><strong>Repartidor: </strong><t t-esc="pickup_info['courier']"/><span t-if="pickup_info['phone']"> · <t t-esc="pickup_info['phone']"/></span></p>
    <p t-else="" class="text-muted">Todavía no hay un repartidor activo asignado. La solicitud queda visible para coordinación.</p>
    <form method="post" t-att-action="'/mi-comercio/pedidos/%s/retiro' % preparation.id" class="d-flex flex-wrap gap-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
     <button t-if="not preparation.pickup_requested_at" type="submit" name="action" value="request" class="btn btn-success">Solicitar retiro</button>
     <button t-if="preparation.pickup_requested_at and pickup_info and pickup_info['assigned']" type="submit" name="action" value="handoff" class="btn btn-success">Confirmar entrega al repartidor</button>
    </form>
   </section>
  </xpath>
  <xpath expr="//p[@t-if=&quot;preparation.state in ('collected','delivered')&quot;]" position="replace"><p t-if="preparation.state == 'collected'" class="alert alert-info mt-3" role="status">El retiro de tus productos está registrado. El repartidor continúa con la entrega de la compra completa.</p><p t-if="preparation.state == 'delivered'" class="alert alert-success mt-3" role="status">La entrega al cliente está registrada. El cobro se registra por separado.</p></xpath>
 </template>
 <template id="merchant_pickup_list" inherit_id="wheelwright_ahorra.merchant_preparations" name="Pedidos y retiros del local">
  <xpath expr="//h1" position="replace"><h1 class="mt-3">Pedidos de mi local</h1></xpath>
  <xpath expr="//a[hasclass('btn-sm')]" position="replace"><a t-att-href="'/mi-comercio/pedidos/%s' % preparation.id" class="btn btn-outline-success btn-sm">Gestionar pedido</a></xpath>
 </template>
 <record id="pickup_coordination_list" model="ir.ui.view"><field name="name">wah.preparation.pickup.coordination.list</field><field name="model">wah.preparation</field><field name="inherit_id" ref="wheelwright_ahorra.preparation_list"/><field name="arch" type="xml"><xpath expr="//field[@name='state']" position="after"><field name="pickup_requested_at" optional="show"/></xpath></field></record>
 <record id="pickup_coordination_search" model="ir.ui.view"><field name="name">wah.preparation.pickup.coordination.search</field><field name="model">wah.preparation</field><field name="inherit_id" ref="wheelwright_ahorra.preparation_search"/><field name="arch" type="xml"><xpath expr="//filter[@name='ready_preparations']" position="after"><filter name="pickup_requested" string="Retiro solicitado" domain="[('state','=','ready'),('pickup_requested_at','!=',False)]"/></xpath></field></record>
 <template id="courier_layout" name="Portal de repartidores wheel-ahorra">
  <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
   <div class="wah-driver-shell"><header class="wah-driver-header"><div class="container"><a href="/mi-reparto" class="wah-driver-brand"><span>w.</span><div>wheel-ahorra<small>PORTAL DE REPARTIDORES</small></div></a><details><summary><i class="fa fa-user-circle" aria-hidden="true"/> <t t-esc="request.env.user.name"/></summary><nav aria-label="Cuenta del repartidor"><a href="/my/account">Mis datos</a><a href="/my/security">Seguridad</a><a href="/shop">Ir a la tienda</a><a href="/web/session/logout?redirect=/web/login">Cerrar sesión</a></nav></details></div></header>
   <main><t t-out="0"/></main><footer class="wah-driver-footer">wheel-ahorra · Reparto en Wheelwright</footer></div>
  </t>
 </template>
 <template id="courier_routes" name="Mis recorridos"><t t-call="wheelwright_ahorra.courier_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant wah-courier py-4"><div class="wah-driver-welcome"><div><span class="wah-driver-eyebrow">TU CENTRO DE TRABAJO</span><h1>Hola, <t t-esc="courier_name"/></h1><p>Todo tu reparto, en un solo lugar. Revisá los pedidos asignados y continuá con el próximo paso.</p></div><a href="/mi-reparto" class="btn btn-outline-success"><i class="fa fa-refresh" aria-hidden="true"/> Actualizar pedidos</a></div>
  <div class="wah-driver-metrics"><a href="/mi-reparto?status=open"><strong t-esc="metrics['assigned']"/><span>Para retirar</span><small>Pedidos asignados</small></a><a href="/mi-reparto?status=open"><strong t-esc="metrics['on_way']"/><span>En camino</span><small>Entrega al vecino</small></a><a href="/mi-reparto?status=open"><strong t-esc="metrics['pending']"/><span>Por cobrar</span><small>Entregados sin cobro registrado</small></a></div>
  <div class="wah-driver-guide"><i class="fa fa-motorcycle" aria-hidden="true"/><p><strong>Tu recorrido paso a paso</strong><br/>Aceptá → Retirá en los locales → Entregá al vecino → Registrá el cobro</p></div><h2 class="wah-driver-section-title">Mis pedidos</h2>
  <nav class="d-flex flex-wrap gap-2 my-4" aria-label="Filtrar recorridos"><a href="/mi-reparto?status=open" t-attf-class="btn #{'btn-success' if status == 'open' else 'btn-outline-success'}">En curso y por cobrar</a><a href="/mi-reparto?status=closed" t-attf-class="btn #{'btn-success' if status == 'closed' else 'btn-outline-success'}">Completados</a><a href="/mi-reparto?status=all" t-attf-class="btn #{'btn-success' if status == 'all' else 'btn-outline-success'}">Todos</a></nav>
  <div t-if="not routes" class="wah-merchant-form"><h3>Todo al día por acá</h3><p>Cuando coordinación te asigne un pedido, aparecerá en este espacio. Usá Actualizar pedidos para consultar novedades.</p></div>
  <div t-else="" class="wah-routes-grid"><article t-foreach="routes" t-as="route" class="wah-merchant-form wah-route-card"><span class="badge bg-secondary" t-esc="route['route_label']"/><h2 t-esc="route['name']"/><p class="wah-driver-next"><strong>Próximo paso: </strong><t t-if="not route['accepted'] and route['route_state'] != 'delivered'">Aceptar recorrido</t><t t-elif="route['route_state'] == 'assigned'">Revisar y registrar retiros</t><t t-elif="route['route_state'] == 'on_way'">Entregar la compra</t><t t-elif="route['collection_state'] == 'pending'">Registrar cobro</t><t t-else="">Recorrido completado</t></p><p t-esc="route['delivery_label'] or 'Entrega a coordinar'"/><p>Total de la compra: <strong t-out="route['amount']" t-options="{'widget':'monetary','display_currency':route['currency']}"/></p><p t-if="route['route_state'] == 'delivered' and route['collection_state'] == 'pending'" class="text-warning">Entregado · Falta registrar el cobro</p><a t-att-href="'/mi-reparto/%s' % route['id']" class="btn btn-success">Gestionar recorrido →</a></article></div><t t-call="portal.pager"/>
 </div></t></template>
 <template id="courier_route_detail" name="Gestionar recorrido"><t t-call="wheelwright_ahorra.courier_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant wah-courier py-4"><a href="/mi-reparto" class="wah-text-link">← Mi reparto</a><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3"><div><h1 t-esc="route['name']"/><p t-esc="route['delivery_label'] or 'Entrega a coordinar'"/></div><span class="badge bg-secondary" t-esc="route['route_label']"/></div>
  <p t-if="updated" class="alert alert-success" role="status">El movimiento se registró correctamente.</p><p t-if="error" class="alert alert-danger" role="alert" t-esc="error"/>
  <section t-if="not route['accepted'] and (route['route_state'] in ('assigned','on_way') or (route['route_state'] == 'delivered' and route['collection_state'] == 'pending'))" class="wah-merchant-form my-4"><h2>Tu próximo recorrido</h2><p>Revisá los retiros y el destino, y aceptá el recorrido para continuar desde su estado actual.</p><form method="post" t-att-action="'/mi-reparto/%s/actualizar' % route['id']"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button name="action" value="accept" type="submit" class="btn btn-success">Aceptar recorrido</button></form></section>
  <div class="wah-route-columns my-4"><section class="wah-merchant-form"><h2>Destino de la compra</h2><strong t-esc="route['customer']"/><p class="text-prewrap mt-2" t-esc="route['address']"/><a t-if="route['phone']" t-att-href="'tel:%s' % route['phone']" t-esc="route['phone']"/><p t-if="route['notes']" class="mt-3"><strong>Indicaciones: </strong><t t-esc="route['notes']"/></p></section><section class="wah-merchant-form"><h2>Importe del pedido</h2><strong class="wah-route-total" t-out="route['amount']" t-options="{'widget':'monetary','display_currency':route['currency']}"/><p>Es el total completo de productos y envío.</p><p t-if="route['cash_tendered']">El cliente indicó pagar con <strong t-out="route['cash_tendered']" t-options="{'widget':'monetary','display_currency':route['currency']}"/>.</p><p class="text-muted">Entregar y registrar el cobro son pasos separados.</p></section></div>
  <section class="wah-merchant-form mb-4"><h2>Retiros de locales</h2><article t-foreach="route['pickups']" t-as="pickup" class="wah-pickup-stop"><div class="d-flex flex-wrap justify-content-between gap-2"><h3 t-esc="pickup['store']"/><span class="badge bg-secondary" t-esc="pickup['state_label']"/></div><p t-esc="pickup['address'] or 'Dirección del local a coordinar'"/><a t-if="pickup['phone']" t-att-href="'tel:%s' % pickup['phone']" t-esc="pickup['phone']"/><p t-if="pickup['requested']" class="text-success mt-2">El comercio solicitó el retiro.</p><p t-if="pickup['note']" class="mt-2" t-esc="pickup['note']"/><ul><li t-foreach="pickup['items']" t-as="item"><strong t-esc="'%g' % item['quantity']"/> <t t-esc="item['uom']"/> · <t t-esc="item['name']"/></li></ul>
   <form t-if="route['accepted'] and route['route_state'] == 'assigned' and pickup['state'] == 'ready'" method="post" t-att-action="'/mi-reparto/%s/actualizar' % route['id']"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="preparation_id" t-att-value="pickup['id']"/><button type="submit" name="action" value="pickup" class="btn btn-outline-success">Registrar retiro de este local</button></form>
  </article></section>
  <section t-if="route['accepted'] and route['route_state'] in ('assigned','on_way')" class="wah-merchant-form mb-4"><h2>Entrega al cliente</h2><p t-if="route['route_state'] == 'assigned'">Registrá todos los retiros antes de salir. El sistema verificará que no falte ningún local.</p><p t-else="">Cuando el cliente reciba la compra completa, registrá la entrega.</p><form method="post" t-att-action="'/mi-reparto/%s/actualizar' % route['id']"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button t-if="route['route_state'] == 'assigned'" name="action" value="depart" type="submit" class="btn btn-success">Marcar En camino</button><button t-else="" name="action" value="deliver" type="submit" class="btn btn-success">Registrar entrega completa</button></form></section>
  <section t-if="route['route_state'] == 'delivered' and route['collection_state'] == 'pending' and route['accepted']" class="wah-merchant-form mb-4"><h2>Registrar cobro</h2><p>Registrá el dinero recibido por la compra completa. Esta acción no realiza una transferencia bancaria.</p><form method="post" t-att-action="'/mi-reparto/%s/actualizar' % route['id']"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3"><div class="col-md-6"><label for="method" class="form-label">Medio de cobro</label><select name="method" id="method" class="form-select" required="required"><option value="cash">Efectivo recibido</option><option value="transfer">Transferencia verificada</option></select></div><div class="col-md-6"><label for="received_amount" class="form-label">Efectivo recibido (solo efectivo)</label><input type="number" id="received_amount" name="received_amount" min="0" step="0.01" t-att-value="route['amount']" class="form-control"/></div><div class="col-12"><label for="reference" class="form-label">Referencia / comprobante</label><input id="reference" name="reference" maxlength="200" class="form-control" placeholder="Obligatorio si verificaste una transferencia"/></div></div><button type="submit" name="action" value="collect" class="btn btn-success mt-3">Confirmar cobro recibido</button></form></section>
  <section t-if="route['receipt']" class="wah-merchant-form mb-4"><h2>Cobro registrado</h2><p><strong t-esc="route['receipt']['name']"/> · <span t-out="route['receipt']['amount']" t-options="{'widget':'monetary','display_currency':route['currency']}"/></p><p>Vuelto: <strong t-out="route['receipt']['change']" t-options="{'widget':'monetary','display_currency':route['currency']}"/></p></section>
 </div></t></template>
</odoo>
