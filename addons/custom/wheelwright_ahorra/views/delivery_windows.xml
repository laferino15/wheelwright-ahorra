<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="delivery_window_checkout" name="Elegir horario de entrega"><t t-call="website.layout"><div id="wrap" class="container wah-merchant wah-delivery-schedule py-5"><a href="/shop/checkout" class="wah-text-link">← Revisar dirección</a><span class="wah-eyebrow wah-green mt-4">TU COMPRA, A TU HORARIO</span><h1>¿Cuándo te lo llevamos?</h1><p>Elegí el día y una franja de entrega en Wheelwright. El pedido llegará dentro de ese rango, sin una hora exacta.</p><div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/><div class="wah-merchant-form"><form action="/shop/entrega" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="wah-window-date"><div><label for="wah_delivery_date" class="form-label">1. Elegí la fecha</label><input type="date" id="wah_delivery_date" name="delivery_date" t-att-min="today" t-att-value="day" required="required" class="form-control"/></div><button type="submit" name="action" value="refresh" formnovalidate="formnovalidate" class="btn btn-outline-success">Ver horarios de esa fecha</button></div><hr class="my-4"/><fieldset><legend class="form-label">2. Elegí una franja para el <t t-esc="day_label"/></legend><div class="wah-window-grid"><label t-foreach="windows" t-as="window" t-attf-class="wah-window-option #{'wah-window-unavailable' if not window[2] else ''}"><input type="radio" name="delivery_window" t-att-value="window[0]" t-att-disabled="not window[2]" t-att-checked="window[0] == selected and window[2]" required="required"/><span><strong t-esc="{'midday':'Mediodía','afternoon':'Tarde','night':'Noche'}[window[0]]"/><span t-esc="window[1]"/><small t-if="not window[2]">Ya comenzó · no disponible</small></span></label></div></fieldset><p class="small mt-3 mb-4">Horarios de Argentina. La franja de 22:00 a 00:00 termina a medianoche del día siguiente. Para el mismo día, elegí una franja que todavía no haya comenzado.</p><div t-if="not has_windows" class="alert alert-info" role="status">No quedan franjas disponibles para esta fecha. Elegí otro día y consultá sus horarios.</div><div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-success" t-att-disabled="not has_windows">Guardar y continuar al pago →</button><a href="/shop/cart" class="btn btn-outline-success">Volver al carrito</a></div></form></div></div></t></template>
 <template id="delivery_payment_summary" inherit_id="website_sale.payment"><xpath expr="//div[@id='oe_structure_website_sale_payment_1']" position="after"><div t-if="website_sale_order.wah_delivery_label" class="alert alert-success wah-window-summary"><strong>Entrega elegida: </strong><span t-field="website_sale_order.wah_delivery_label"/><a href="/shop/entrega" class="d-block mt-2">Cambiar fecha u horario →</a></div></xpath></template>
 <template id="delivery_confirmation_summary" inherit_id="website_sale.confirmation"><xpath expr="//div[@id='order_name']" position="after"><p t-if="order.wah_delivery_label" class="alert alert-success"><strong>Entrega programada: </strong><span t-field="order.wah_delivery_label"/></p></xpath></template>
 <template id="delivery_portal_summary" inherit_id="sale.sale_order_portal_content"><xpath expr="//div[@id='introduction']" position="after"><p t-if="sale_order.wah_delivery_label" class="alert alert-success my-3"><strong>Entrega programada: </strong><span t-field="sale_order.wah_delivery_label"/></p></xpath></template>
 <template id="preparation_window_detail" inherit_id="wheelwright_ahorra.merchant_preparation_detail"><xpath expr="//div[hasclass('wah-merchant')]/div[hasclass('wah-merchant-form')][1]" position="before"><p t-if="preparation.wah_delivery_label" class="alert alert-info"><strong>Preparar para la entrega: </strong><span t-field="preparation.wah_delivery_label"/></p></xpath></template>
 <template id="preparation_window_list" inherit_id="wheelwright_ahorra.merchant_preparations"><xpath expr="//thead/tr/th[2]" position="after"><th>Entrega</th></xpath><xpath expr="//tbody/tr/td[2]" position="after"><td><span t-esc="preparation.wah_delivery_label or 'Sin franja asignada'"/></td></xpath></template>
 <record id="delivery_window_order_form" model="ir.ui.view"><field name="name">sale.order.delivery.window.form</field><field name="model">sale.order</field><field name="inherit_id" ref="wheelwright_ahorra.sale_order_local_delivery"/><field name="arch" type="xml"><field name="wah_delivery_notes" position="before"><field name="wah_delivery_date"/><field name="wah_delivery_window"/></field></field></record>
 <record id="delivery_window_search" model="ir.ui.view"><field name="name">sale.order.delivery.window.search</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_sales_order_filter"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><field name="wah_delivery_date"/><field name="wah_delivery_window"/><filter name="wah_by_date" string="Fecha de entrega" context="{'group_by':'wah_delivery_date:day'}"/><filter name="wah_by_window" string="Franja horaria" context="{'group_by':'wah_delivery_window'}"/></xpath></field></record>
 <record id="delivery_window_order_list" model="ir.ui.view"><field name="name">sale.order.delivery.window.list</field><field name="model">sale.order</field><field name="arch" type="xml"><list><field name="name"/><field name="wah_delivery_date"/><field name="wah_delivery_window"/><field name="partner_id"/><field name="partner_shipping_id" optional="show"/><field name="wah_preparation_state"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="state"/></list></field></record>
 <record id="delivery_window_action" model="ir.actions.act_window"><field name="name">Pedidos por franja</field><field name="res_model">sale.order</field><field name="view_mode">list,form</field><field name="view_id" ref="delivery_window_order_list"/><field name="domain">[('website_id','!=',False),('state','=','sale')]</field><field name="context">{'search_default_wah_by_date':1,'search_default_wah_by_window':1}</field></record>
 <menuitem id="delivery_window_menu" name="Pedidos por franja" parent="wheelwright_ahorra.marketplace_menu" action="delivery_window_action" sequence="40"/>
 <record id="preparation_window_admin_list" model="ir.ui.view"><field name="name">wah.preparation.delivery.window.list</field><field name="model">wah.preparation</field><field name="inherit_id" ref="wheelwright_ahorra.preparation_list"/><field name="arch" type="xml"><field name="placed_at" position="after"><field name="wah_delivery_date"/><field name="wah_delivery_window"/></field></field></record>
 <record id="preparation_window_admin_form" model="ir.ui.view"><field name="name">wah.preparation.delivery.window.form</field><field name="model">wah.preparation</field><field name="inherit_id" ref="wheelwright_ahorra.preparation_form"/><field name="arch" type="xml"><field name="placed_at" position="after"><field name="wah_delivery_date"/><field name="wah_delivery_window"/></field></field></record>
</odoo>
