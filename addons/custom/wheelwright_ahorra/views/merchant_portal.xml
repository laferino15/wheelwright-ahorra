<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="merchant_layout" name="Portal propio de comercios">
  <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
   <div class="wah-driver-shell wah-business-shell"><header class="wah-driver-header"><div class="container"><a href="/mi-comercio" class="wah-driver-brand"><span>w.</span><div>wheel-ahorra<small>PORTAL DE COMERCIOS</small></div></a><details><summary><i class="fa fa-user-circle" aria-hidden="true"/> <t t-esc="request.env.user.name"/></summary><nav aria-label="Cuenta del comercio"><a href="/my/account">Mis datos</a><a href="/my/security">Seguridad</a><a t-if="request.env['wah.courier'].sudo().search_count([('user_id','=',request.env.uid),('active','=',True)])" href="/mi-reparto">Mi reparto</a><a href="/shop">Ir a la tienda</a><a href="/web/session/logout?redirect=/web/login">Cerrar sesión</a></nav></details></div></header>
   <nav class="wah-business-nav" aria-label="Portal del comercio"><div class="container"><a href="/mi-comercio" t-att-class="'active' if request.httprequest.path == '/mi-comercio' else ''"><i class="fa fa-home" aria-hidden="true"/> Resumen</a><a href="/mi-comercio/productos" t-att-class="'active' if '/productos' in request.httprequest.path and not request.httprequest.path.endswith('/stock') else ''"><i class="fa fa-cubes" aria-hidden="true"/> Productos</a><a href="/mi-comercio/stock" t-att-class="'active' if request.httprequest.path.endswith('/stock') else ''"><i class="fa fa-list-alt" aria-hidden="true"/> Stock</a><a href="/mi-comercio/pedidos" t-att-class="'active' if '/pedidos' in request.httprequest.path else ''"><i class="fa fa-shopping-bag" aria-hidden="true"/> Pedidos</a></div></nav>
   <main id="wrap"><t t-out="0"/></main><footer class="wah-driver-footer">wheel-ahorra · Tu comercio en Wheelwright</footer></div>
  </t>
 </template>
 <template id="merchant_hub" name="Centro de trabajo del comercio"><t t-call="wheelwright_ahorra.merchant_layout"><div class="container wah-merchant wah-business py-4">
  <div class="wah-driver-welcome"><div><span class="wah-driver-eyebrow">TU CENTRO DE TRABAJO</span><h1 t-esc="store.name"/><p>Gestioná tus productos, mantené el stock al día y prepará los pedidos de tus vecinos.</p><span class="wah-status" t-att-data-state="store.state" t-field="store.state"/></div><a href="/mi-comercio/registro" class="btn btn-outline-success">Datos de mi local</a></div>
  <div t-if="notice" role="status" class="alert alert-success" t-esc="notice"/><div t-if="store.review_notes" class="alert alert-info" t-esc="store.review_notes"/>
  <div t-if="store.state != 'approved'" class="wah-merchant-form mb-4"><h2>Tu local está en revisión</h2><p>Cuando la administración lo apruebe, vas a poder cargar y publicar tus productos.</p></div>
  <div t-if="section == 'home'" class="wah-driver-metrics wah-business-metrics"><a href="/mi-comercio/productos"><strong t-esc="metrics['products']"/><span>Mis productos</span><small>Catálogo de tu local</small></a><a href="/mi-comercio/stock"><strong t-esc="metrics['empty']"/><span>Sin stock</span><small>Productos con cantidad agotada</small></a><a href="/mi-comercio/pedidos"><strong t-esc="metrics['orders']"/><span>Pedidos en curso</span><small><t t-esc="metrics['ready']"/> listos para retirar</small></a></div>
  <t t-if="section == 'home'"><div class="wah-business-actions"><a href="/mi-comercio/productos/nuevo" t-if="store.state == 'approved'" class="btn btn-success">Agregar producto</a><a href="/mi-comercio/stock" class="btn btn-outline-success">Actualizar stock</a><a href="/mi-comercio/pedidos" class="btn btn-outline-success">Ver pedidos</a></div><section class="wah-merchant-form my-4"><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><h2 class="mb-0">Pedidos para atender</h2><a href="/mi-comercio/pedidos" class="wah-text-link">Ver todos →</a></div><p t-if="not recent_orders" class="mb-0">Todo al día. Las compras confirmadas que incluyan tus productos aparecerán acá.</p><div t-foreach="recent_orders" t-as="prep" class="wah-business-order"><div><strong t-esc="prep.reference"/><small class="d-block" t-field="prep.placed_at"/></div><span class="wah-status" t-att-data-state="prep.state" t-field="prep.state"/><a t-att-href="'/mi-comercio/pedidos/%s' % prep.id" class="btn btn-outline-success">Gestionar pedido</a></div></section><div class="wah-driver-guide"><i class="fa fa-shopping-bag" aria-hidden="true"/><p><strong>Tu local, listo para vender</strong><br/>Cargá tus productos → Actualizá el stock → Prepará los pedidos → Entregá al repartidor</p></div></t>
  <t t-else=""><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><h2><t t-if="section == 'stock'">Stock de mis productos</t><t t-else="">Mis productos</t></h2><a t-if="store.state == 'approved'" href="/mi-comercio/productos/nuevo" class="btn btn-success">Agregar producto</a></div>
  <p t-if="section == 'stock'">La cantidad indica las presentaciones que todavía podés vender. Ajustar stock o pausar la venta no requiere una nueva aprobación.</p><p t-else="">Los cambios de nombre, precio o presentación se envían a revisión antes de publicarse.</p>
  <div t-if="not products" class="wah-merchant-form"><h3>Tu catálogo empieza acá</h3><p>Agregá tu primer producto con foto, presentación, precio y stock disponible.</p></div>
  <div t-else="" class="wah-business-products"><article t-foreach="products" t-as="product" class="wah-merchant-form wah-business-product"><div class="wah-business-product-title"><span class="wah-business-product-icon"><i class="fa fa-cube" aria-hidden="true"/></span><div><h3 t-esc="product.name"/><p t-esc="product.presentation"/></div></div><div class="d-flex flex-wrap gap-2 my-3"><span class="wah-status" t-att-data-state="product.state" t-field="product.state"/><span t-if="not product.available" class="wah-status" data-state="cancelled">Venta pausada</span><span t-elif="product.stock_tracking and product.stock_quantity &lt;= 0" class="wah-status" data-state="rejected">Agotado</span></div><div class="wah-business-product-info"><div><small>Precio final</small><strong t-field="product.price"/></div><div><small>Stock disponible</small><strong t-if="product.stock_tracking"><t t-esc="'%g' % product.stock_quantity"/> <small>presentaciones</small></strong><strong t-else="" class="wah-business-untracked">Sin control de cantidad</strong></div></div><p t-if="product.review_notes" class="alert alert-info mt-3" t-esc="product.review_notes"/><div class="wah-business-actions"><a t-att-href="'/mi-comercio/productos/%s/stock' % product.id" class="btn btn-success">Ajustar stock</a><a t-att-href="'/mi-comercio/productos/%s' % product.id" class="btn btn-outline-success">Editar producto</a><form t-if="product.state in ('draft','rejected')" t-att-action="'/mi-comercio/productos/%s/enviar' % product.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-outline-success" type="submit">Enviar a revisión</button></form></div></article></div></t>
 </div></t></template>
 <template id="business_shell_merchant_register" inherit_id="wheelwright_ahorra.merchant_register" priority="1100"><xpath expr="//t[@t-call='portal.portal_layout']" position="attributes"><attribute name="t-call">wheelwright_ahorra.merchant_layout</attribute></xpath></template>
 <template id="business_shell_merchant_product_form" inherit_id="wheelwright_ahorra.merchant_product_form" priority="1100"><xpath expr="//t[@t-call='portal.portal_layout']" position="attributes"><attribute name="t-call">wheelwright_ahorra.merchant_layout</attribute></xpath></template>
 <template id="business_shell_merchant_stock_form" inherit_id="wheelwright_ahorra.merchant_stock_form" priority="1100"><xpath expr="//t[@t-call='portal.portal_layout']" position="attributes"><attribute name="t-call">wheelwright_ahorra.merchant_layout</attribute></xpath></template>
 <template id="business_shell_merchant_preparations" inherit_id="wheelwright_ahorra.merchant_preparations" priority="1100"><xpath expr="//t[@t-call='portal.portal_layout']" position="attributes"><attribute name="t-call">wheelwright_ahorra.merchant_layout</attribute></xpath></template>
 <template id="business_shell_merchant_preparation_detail" inherit_id="wheelwright_ahorra.merchant_preparation_detail" priority="1100"><xpath expr="//t[@t-call='portal.portal_layout']" position="attributes"><attribute name="t-call">wheelwright_ahorra.merchant_layout</attribute></xpath></template>
</odoo>