<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="local_address" inherit_id="website_sale.address" name="Entrega local wheel-ahorra">
  <xpath expr="//t[@t-call='website_sale.address_form_fields']" position="replace">
   <t t-if="website.wah_local_checkout" t-call="wheelwright_ahorra.local_address_fields"/>
   <t t-else="" t-call="website_sale.address_form_fields"/>
  </xpath>
  <xpath expr="//form[@name='address_form']" position="attributes"><attribute name="t-attf-class">address_autoformat #{'wah-checkout' if website.wah_local_checkout else ''}</attribute></xpath>
  <xpath expr="//form[@name='address_form']//h4" position="replace"><h4 t-if="website.wah_local_checkout">¿Dónde te lo llevamos?</h4><h4 t-else="">Detalles</h4></xpath>
 </template>
 <template id="local_address_fields" name="Datos de entrega wheel-ahorra">
  <div class="col-12 wah-checkout-location"><i class="fa fa-map-marker" aria-hidden="true"/> Entregas en <strong>Wheelwright, Santa Fe</strong><p>Completá tus datos. Podés comprar sin crear una cuenta.</p></div>
  <div id="div_name" class="col-md-6 mb-3"><label for="o_name" class="col-form-label">Nombre y apellido</label><input id="o_name" name="name" class="form-control" autocomplete="name" required="required" t-att-value="partner_sudo.name" placeholder="¿Quién recibe el pedido?"/></div>
  <div id="div_phone" class="col-md-6 mb-3"><label for="o_phone" class="col-form-label">Teléfono / WhatsApp</label><input id="o_phone" name="phone" type="tel" class="form-control" autocomplete="tel" required="required" t-att-value="partner_sudo.phone" placeholder="Tu número de contacto"/></div>
  <div id="div_street" class="col-12 mb-3"><label for="o_street" class="col-form-label">Calle y número</label><input id="o_street" name="street" class="form-control" autocomplete="address-line1" required="required" t-att-value="partner_sudo.street" placeholder="Por ejemplo: tu calle y altura"/></div>
  <div id="div_street2" class="col-12 mb-3"><label for="o_street2" class="col-form-label label-optional">Referencia del domicilio (opcional)</label><input id="o_street2" name="street2" class="form-control" maxlength="200" t-att-value="partner_sudo.street2" placeholder="Departamento, entrecalles, portón verde…"/></div>
  <div id="div_email" class="col-12 mb-3"><label for="o_email" class="col-form-label label-optional">Correo electrónico (opcional)</label><input id="o_email" name="email" type="email" class="form-control" autocomplete="email" t-att-value="partner_sudo.email" placeholder="Para recibir información del pedido"/></div>
  <div class="col-12 mb-3"><label for="wah_delivery_notes" class="col-form-label label-optional">Observaciones del pedido (opcional)</label><textarea id="wah_delivery_notes" name="wah_delivery_notes" class="form-control" rows="3" maxlength="1000" placeholder="Por ejemplo: tocar timbre al llegar"><t t-esc="website_sale_order.wah_delivery_notes or ''"/></textarea></div>
  <div class="col-12 wah-checkout-payment mb-3"><h5><i class="fa fa-money" aria-hidden="true"/> Efectivo al recibir</h5><p>Pagás cuando recibís tu pedido. Revisá el total antes de confirmar.</p><label for="wah_cash_tendered" class="col-form-label label-optional">¿Con cuánto vas a pagar? (opcional)</label><div class="input-group"><span class="input-group-text">$</span><input id="wah_cash_tendered" name="wah_cash_tendered" type="number" min="0" step="0.01" inputmode="decimal" class="form-control" placeholder="Importe para preparar cambio" t-att-value="website_sale_order.wah_cash_tendered or ''"/></div><small>Si todavía no lo sabés, dejalo en blanco.</small></div>
  <div class="col-12 mb-3"><details class="wah-invoice" t-att-open="'open' if current_partner.vat else None"><summary>Necesito factura con datos específicos</summary><div class="form-check mt-3"><input type="checkbox" id="wah_invoice" name="wah_invoice" value="1" class="form-check-input" t-att-checked="website_sale_order.wah_invoice_requested or current_partner.vat"/><label for="wah_invoice" class="form-check-label">Usar estos datos para la facturación</label></div><p class="small text-muted mt-2">Para compras particulares usamos Consumidor final. Si necesitás otros datos, marcá la opción y completalos.</p>
   <div class="row">
    <div id="company_name_div" class="col-12 mb-3"><label for="o_company_name" class="col-form-label label-optional">Razón social (si corresponde)</label><input id="o_company_name" name="company_name" class="form-control" t-att-value="current_partner.commercial_company_name" t-att-readonly="not is_main_address"/></div>
    <div class="col-md-6 mb-3"><label for="wah_responsibility" class="col-form-label">Condición fiscal</label><select id="wah_responsibility" name="l10n_ar_afip_responsibility_type_id" class="form-select" t-att-disabled="not can_edit_vat"><option t-foreach="request.env['l10n_ar.afip.responsibility.type'].search([])" t-as="resp" t-att-value="resp.id" t-att-selected="resp == (current_partner.l10n_ar_afip_responsibility_type_id or request.env.ref('l10n_ar.res_CF'))" t-esc="resp.name"/></select></div>
    <div class="col-md-6 mb-3"><label for="wah_identification" class="col-form-label">Tipo de documento</label><select id="wah_identification" name="l10n_latam_identification_type_id" class="form-select" t-att-disabled="not can_edit_vat"><option t-foreach="request.env['l10n_latam.identification.type'].search([('country_id','in',[False,wah_country.id])])" t-as="it" t-att-value="it.id" t-att-selected="it == (current_partner.l10n_latam_identification_type_id or request.env.ref('l10n_ar.it_cuit'))" t-esc="it.name"/></select></div>
    <div id="div_vat" class="col-12 mb-2"><label for="o_vat" class="col-form-label label-optional">Número de documento / CUIT</label><input id="o_vat" name="vat" class="form-control" t-att-value="current_partner.vat" t-att-readonly="not can_edit_vat"/></div>
   </div>
  </details></div>
  <div class="col-12 wah-checkout-notice">Revisá tu domicilio y teléfono antes de continuar. En el próximo paso vas a revisar y confirmar el pedido.</div>
  <input type="hidden" name="city" id="o_city" value="Wheelwright"/><input type="hidden" name="zip" id="o_zip" value="2722"/><input type="hidden" name="country_id" id="o_country_id" t-att-value="wah_country.id"/><input type="hidden" name="state_id" id="o_state_id" t-att-value="wah_state.id"/>
  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="address_type" t-att-value="address_type"/><input type="hidden" name="use_delivery_as_billing" t-att-value="use_delivery_as_billing"/><input type="hidden" name="parent_id" t-att-value="parent_id"/><input t-if="partner_id" type="hidden" name="partner_id" t-att-value="partner_id"/><input t-if="callback" type="hidden" name="callback" t-att-value="callback"/><input type="hidden" name="required_fields" value="name,phone,street"/>
 </template>
 <record id="sale_order_local_delivery" model="ir.ui.view"><field name="name">sale.order.wah.delivery</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Entrega wheel-ahorra" invisible="not website_id"><group><field name="wah_delivery_notes"/><field name="wah_cash_tendered"/><field name="wah_invoice_requested"/></group></page></xpath></field></record>
 <template id="local_product_terms" inherit_id="website_sale.product_terms_and_conditions"><xpath expr="//small" position="replace"><small t-if="website.wah_local_checkout" class="text-muted">Compra local en Wheelwright. Revisá los datos y condiciones de entrega al finalizar.</small><small t-else="" class="text-muted"><a href="/terms">Términos y condiciones</a></small></xpath></template>
</odoo>
