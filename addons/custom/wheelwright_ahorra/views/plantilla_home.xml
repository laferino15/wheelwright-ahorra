<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="home_wheelwright" name="wheel-ahorra · Inicio" inherit_id="website.homepage">
  <xpath expr="//div[@id='wrap']" position="replace">
   <div id="wrap" class="oe_structure wah-home">
    <t t-set="wah_categories" t-value="request.env['product.public.category'].search([('website_id','in',[False,website.id]),('parent_id','=',False)], limit=5, order='sequence, id')"/>
    <t t-set="wah_products" t-value="request.env['product.template'].browse()"/>
    <t t-foreach="wah_categories" t-as="wah_category"><t t-set="wah_products" t-value="wah_products | request.env['product.template'].search(website.sale_product_domain() + [('public_categ_ids','child_of',wah_category.id)], limit=1, order='website_sequence, id')"/></t>
    <t t-set="wah_products" t-value="(wah_products | request.env['product.template'].search(website.sale_product_domain(), limit=8, order='website_sequence, id'))[:8]"/>
    <t t-set="wah_prices" t-value="wah_products._get_sales_prices(website)"/>
    <section class="wah-hero"><div class="container wah-hero-inner"><div class="wah-hero-copy"><span class="wah-eyebrow">EL VALOR DE COMPRAR CERCA</span><h1>Lo que necesitás,<br/><em>más cerca.</em></h1><p>Tus locales de siempre, ahora en un mismo lugar. Elegí productos, armá tu pedido y seguí tu compra desde tu cuenta.</p><a href="/shop" class="wah-button wah-button-yellow">Explorar la tienda <span aria-hidden="true">↗</span></a><a href="#como-comprar" class="wah-hero-secondary">Así funciona <span aria-hidden="true">→</span></a><div class="wah-hero-note"><i class="fa fa-heart-o" aria-hidden="true"/> Elegí local. Apoyá a Wheelwright.</div></div><div class="wah-hero-art"><span class="wah-art-circle"/><img src="/wheelwright_ahorra/static/src/img/compras.svg" alt="Bolsa de compras con pan y alimentos frescos"/><span class="wah-art-label">De acá.<br/><strong>Para vos.</strong></span></div></div></section>
    <div class="wah-value-strip"><div class="container"><div><i class="fa fa-map-marker" aria-hidden="true"/><span><strong>Comercios de acá</strong>Elegí los locales de tu ciudad.</span></div><div><i class="fa fa-shopping-basket" aria-hidden="true"/><span><strong>Una sola compra</strong>Sumá productos de distintos rubros.</span></div><div><i class="fa fa-check-circle-o" aria-hidden="true"/><span><strong>Seguí tu pedido</strong>Consultá cómo avanza desde tu cuenta.</span></div></div></div>
    <section id="categorias" class="wah-section"><div class="container"><div class="wah-section-heading"><div><span class="wah-eyebrow wah-green">UN POCO DE TODO, CERCA TUYO</span><h2>Lo que buscás, por categoría.</h2></div><a href="/shop" class="wah-text-link">Ver todo <span aria-hidden="true">→</span></a></div>
     <div class="wah-category-grid"><t t-foreach="wah_categories" t-as="category"><a t-att-href="'/shop/category/%s' % category.id" t-attf-class="wah-category-card wah-category-#{category_index % 5}"><div><h3 t-esc="category.name"/><span>Explorar productos ↗</span></div><div class="wah-category-visual"><img t-if="category.image_1920" t-att-src="'/web/image/product.public.category/%s/image_512' % category.id" t-att-alt="category.name" loading="lazy"/><i t-else="" t-attf-class="fa #{['fa-cutlery','fa-coffee','fa-heart-o','fa-wrench','fa-leaf'][category_index % 5]}" aria-hidden="true"/></div></a></t><div t-if="not wah_categories" class="wah-empty-state">Estamos preparando las categorías de la tienda.</div></div>
    </div></section>
    <section class="wah-section wah-catalog"><div class="container"><div class="wah-section-heading"><div><span class="wah-eyebrow wah-green">DESCUBRÍ EL CATÁLOGO</span><h2>Un poco de todo para vos</h2></div><a href="/shop" class="wah-text-link">Ir a la tienda →</a></div><div class="wah-product-grid"><t t-foreach="wah_products" t-as="product"><article class="wah-product-card"><a t-att-href="product.website_url" class="wah-product-image"><img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/></a><div class="wah-product-info"><span class="wah-product-category" t-esc="product.public_categ_ids[:1].name or 'Compra local'"/><a t-att-href="product.website_url" class="wah-product-name" t-esc="product.name"/><span class="wah-product-price" t-out="wah_prices[product.id]['price_reduce']" t-options="{'widget':'monetary','display_currency':website.currency_id}"/><a t-att-href="product.website_url" class="wah-product-action">Ver producto <span aria-hidden="true">→</span></a></div></article></t><div t-if="not wah_products" class="wah-empty-state"><i class="fa fa-shopping-basket" aria-hidden="true"/><h3>Estamos preparando la tienda</h3><p>Pronto vas a encontrar acá los productos de nuestros comercios locales.</p><a href="/shop" class="wah-text-link">Explorar la tienda →</a></div></div></div></section>
    <section id="como-comprar" class="wah-section"><div class="container"><div class="wah-delivery-banner"><div><span class="wah-eyebrow">UNA COMPRA, MUCHAS POSIBILIDADES</span><h2>Tu próxima compra<br/>empieza en tu ciudad.</h2><p>Recorré el catálogo y descubrí lo que tenés cerca.</p><a href="/shop" class="wah-button wah-button-yellow">Empezar a comprar ↗</a></div><div class="wah-steps"><div><span>01</span><p><strong>Explorá</strong>Buscá por categoría o producto.</p></div><div><span>02</span><p><strong>Elegí</strong>Revisá precios y presentaciones.</p></div><div><span>03</span><p><strong>Armá tu pedido</strong>Completá tus datos al finalizar.</p></div></div></div></div></section>
    <div class="wah-local-strip"><div class="container"><div><span class="wah-eyebrow wah-green">HECHO PARA NUESTRA CIUDAD</span><h2>Comprar cerca nos conecta.</h2><p>Cada pedido es una oportunidad para elegir a los comercios de Wheelwright.</p></div><i class="fa fa-heart-o" aria-hidden="true"/></div></div>
   </div>
  </xpath>
 </template>
</odoo>