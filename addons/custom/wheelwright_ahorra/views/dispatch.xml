<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="collection_sequence" model="ir.sequence"><field name="name">Cobros wheel-ahorra</field><field name="code">wah.collection</field><field name="prefix">WA-C/%(year)s/</field><field name="padding">5</field></record>
 <record id="courier_list" model="ir.ui.view"><field name="name">wah.courier.list</field><field name="model">wah.courier</field><field name="arch" type="xml"><list><field name="name"/><field name="phone"/><field name="active"/></list></field></record>
 <record id="courier_form" model="ir.ui.view"><field name="name">wah.courier.form</field><field name="model">wah.courier</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="phone"/><field name="active"/></group></sheet></form></field></record>
 <record id="courier_action" model="ir.actions.act_window"><field name="name">Repartidores</field><field name="res_model">wah.courier</field><field name="view_mode">list,form</field></record>
 <record id="collection_list" model="ir.ui.view"><field name="name">wah.collection.list</field><field name="model">wah.collection</field><field name="arch" type="xml"><list create="0" delete="0" edit="0" decoration-muted="state == 'void'"><field name="name"/><field name="order_id"/><field name="collected_at"/><field name="method"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="courier_id"/><field name="actor_id"/><field name="state" widget="badge" decoration-success="state == 'posted'" decoration-danger="state == 'void'"/></list></field></record>
 <record id="collection_form" model="ir.ui.view"><field name="name">wah.collection.form</field><field name="model">wah.collection</field><field name="arch" type="xml"><form create="0" delete="0" edit="0"><header><button name="action_void_wizard" type="object" string="Anular con motivo" invisible="state != 'posted'"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><div class="alert alert-info" role="status">Registro operativo de cobro del reparto. No genera una factura ni un pago contable de Odoo.</div><group><group><field name="order_id"/><field name="method"/><field name="reference"/><field name="courier_id"/></group><group><field name="currency_id" invisible="1"/><field name="amount"/><field name="received_amount" invisible="method != 'cash'"/><field name="change_amount" invisible="method != 'cash'"/><field name="collected_at"/><field name="actor_id"/></group></group><group invisible="state != 'void'" string="Anulación"><field name="void_reason"/><field name="voided_at"/><field name="voided_by"/></group></sheet></form></field></record>
 <record id="collection_search" model="ir.ui.view"><field name="name">wah.collection.search</field><field name="model">wah.collection</field><field name="arch" type="xml"><search><field name="name"/><field name="order_id"/><field name="courier_id"/><filter name="posted" string="Registrados" domain="[('state','=','posted')]"/><filter name="void" string="Anulados" domain="[('state','=','void')]"/><group><filter name="by_courier" string="Repartidor" context="{'group_by':'courier_id'}"/><filter name="by_method" string="Medio de cobro" context="{'group_by':'method'}"/></group></search></field></record>
 <record id="collection_action" model="ir.actions.act_window"><field name="name">Registros de cobro</field><field name="res_model">wah.collection</field><field name="view_mode">list,form</field></record>
 <record id="collection_register_form" model="ir.ui.view"><field name="name">wah.collection.register.form</field><field name="model">wah.collection.register</field><field name="arch" type="xml"><form><div class="alert alert-warning" role="status">Registrá el cobro únicamente después de recibir el efectivo o verificar la transferencia. Se guarda el importe completo del pedido.</div><group><field name="order_id"/><field name="currency_id" invisible="1"/><field name="amount"/><field name="method"/><field name="received_amount" invisible="method != 'cash'" required="method == 'cash'"/><field name="change_amount" invisible="method != 'cash'"/><field name="reference" required="method == 'transfer'"/></group><footer><button name="action_register" string="Confirmar cobro recibido" type="object" class="btn-primary"/><button string="Volver" special="cancel"/></footer></form></field></record>
 <record id="collection_void_form" model="ir.ui.view"><field name="name">wah.collection.void.form</field><field name="model">wah.collection.void</field><field name="arch" type="xml"><form><p>Anular este registro no devuelve dinero ni anula transferencias. El original y el motivo quedan en el historial.</p><group><field name="collection_id"/><field name="reason"/></group><footer><button name="action_void" string="Anular registro" type="object" class="btn-primary"/><button string="Volver" special="cancel"/></footer></form></field></record>
 <record id="dispatch_list" model="ir.ui.view"><field name="name">sale.order.wah.dispatch.list</field><field name="model">sale.order</field><field name="arch" type="xml"><list create="0" delete="0"><field name="name"/><field name="wah_delivery_date"/><field name="wah_delivery_window"/><field name="partner_id"/><field name="wah_courier_id"/><field name="wah_preparation_state"/><field name="wah_route_state" widget="badge" decoration-success="wah_route_state == 'delivered'" decoration-info="wah_route_state == 'on_way'"/><field name="wah_collection_state" widget="badge" decoration-warning="wah_collection_state == 'pending'" decoration-success="wah_collection_state == 'collected'"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/></list></field></record>
 <record id="dispatch_form" model="ir.ui.view"><field name="name">sale.order.wah.dispatch.form</field><field name="model">sale.order</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_wah_assign" type="object" string="Asignar repartidor" class="btn-primary" invisible="wah_route_state not in ('pending','assigned') or state != 'sale'"/><button name="action_wah_dispatch" type="object" string="Marcar En camino" class="btn-primary" invisible="wah_route_state != 'assigned' or state != 'sale'"/><button name="action_wah_deliver" type="object" string="Registrar entrega" class="btn-primary" invisible="wah_route_state != 'on_way' or state != 'sale'"/><button name="action_wah_collection_wizard" type="object" string="Registrar cobro" class="btn-primary" invisible="wah_route_state != 'delivered' or wah_collection_state != 'pending' or state != 'sale'"/><field name="wah_route_state" widget="statusbar"/></header><sheet><h1><field name="name" readonly="1"/></h1><field name="state" invisible="1"/><field name="currency_id" invisible="1"/><div class="alert alert-info" role="status">Registrar la entrega no registra el cobro. Completá ambos pasos por separado.</div><group><group string="Planificación"><field name="wah_delivery_date" readonly="wah_route_state in ('on_way','delivered','cancelled')"/><field name="wah_delivery_window" readonly="wah_route_state in ('on_way','delivered','cancelled')"/><field name="wah_courier_id" readonly="wah_route_state in ('on_way','delivered','cancelled')"/><field name="wah_preparation_state" readonly="1"/></group><group string="Cobro"><field name="amount_total" readonly="1"/><field name="wah_collection_state"/><field name="wah_collection_amount"/><field name="wah_cash_tendered" readonly="1"/><field name="wah_departed_at"/><field name="wah_delivered_at"/></group></group><group string="Destino e indicaciones"><field name="partner_shipping_id" readonly="1" widget="contact" options="{'fields':['name','address','phone']}"/><field name="wah_delivery_notes" readonly="1"/><field name="wah_dropoff_details" invisible="not wah_dropoff_details"/></group><notebook><page string="Retiros de locales"><p>El comerciante marca su preparación lista. Registrá cada retiro cuando el repartidor reciba los productos; después podés marcar el pedido En camino.</p><field name="wah_preparation_ids" readonly="1"><list create="0" delete="0" edit="0"><field name="store_name"/><field name="state"/><field name="merchant_note"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="collected_at"/><button name="action_collect" type="object" string="Registrar retiro" invisible="state != 'ready'"/></list></field></page><page string="Cobros"><p>Los registros son operativos. No generan facturas ni asientos contables.</p><field name="wah_collection_ids" readonly="1"><list create="0" delete="0" edit="0"><field name="name"/><field name="collected_at"/><field name="method"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="actor_id"/><field name="state"/><button name="action_void_wizard" type="object" string="Anular con motivo" invisible="state != 'posted'"/></list></field></page><page string="Historial"><field name="wah_route_event_ids" readonly="1"><list create="0" delete="0" edit="0"><field name="occurred_at"/><field name="actor_id"/><field name="description"/></list></field></page></notebook></sheet></form></field></record>
 <record id="dispatch_search" model="ir.ui.view"><field name="name">sale.order.wah.dispatch.search</field><field name="model">sale.order</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="wah_courier_id"/><field name="wah_delivery_date"/><field name="wah_delivery_window"/><filter name="to_process" string="Por completar" domain="['&amp;',('state','=','sale'),'|',('wah_route_state','not in',['delivered','cancelled']),'&amp;',('wah_route_state','=','delivered'),('wah_collection_state','=','pending')]"/><filter name="on_way" string="En camino" domain="[('wah_route_state','=','on_way')]"/><filter name="delivered" string="Entregados" domain="[('wah_route_state','=','delivered')]"/><filter name="uncollected" string="Entregados sin cobrar" domain="[('wah_route_state','=','delivered'),('wah_collection_state','=','pending')]"/><group><filter name="by_date" string="Fecha de entrega" context="{'group_by':'wah_delivery_date:day'}"/><filter name="by_window" string="Franja horaria" context="{'group_by':'wah_delivery_window'}"/><filter name="by_courier" string="Repartidor" context="{'group_by':'wah_courier_id'}"/></group></search></field></record>
 <record id="dispatch_action" model="ir.actions.act_window"><field name="name">Reparto y cobros</field><field name="res_model">sale.order</field><field name="view_mode">list,form</field><field name="view_id" ref="dispatch_list"/><field name="search_view_id" ref="dispatch_search"/><field name="domain">[('website_id','!=',False),('state','in',['sale','cancel'])]</field><field name="context">{'search_default_to_process':1,'search_default_by_date':1,'search_default_by_window':1}</field></record>
 <record id="dispatch_action_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="dispatch_list"/><field name="act_window_id" ref="dispatch_action"/></record>
 <record id="dispatch_action_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="dispatch_form"/><field name="act_window_id" ref="dispatch_action"/></record>
 <menuitem id="dispatch_menu" name="Reparto y cobros" parent="wheelwright_ahorra.marketplace_menu" action="dispatch_action" sequence="45"/>
 <menuitem id="courier_menu" name="Repartidores" parent="wheelwright_ahorra.marketplace_menu" action="courier_action" sequence="46"/>
 <menuitem id="collection_menu" name="Registros de cobro" parent="wheelwright_ahorra.marketplace_menu" action="collection_action" sequence="47"/>
 <template id="customer_collection_status" inherit_id="sale.sale_order_portal_content"><xpath expr="//div[@id='introduction']" position="after"><div t-if="sale_order.website_id and sale_order.state == 'sale'" class="alert alert-info my-3"><strong>Cobro del reparto: </strong><span t-field="sale_order.wah_collection_state"/></div></xpath></template>
 <record id="dispatch_sale_order_entry" model="ir.ui.view"><field name="name">sale.order.wah.dispatch.entry</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Reparto y cobros" groups="product.group_product_manager" invisible="not website_id"><group><field name="wah_route_state"/><field name="wah_courier_id" readonly="1"/><field name="wah_collection_state"/><field name="wah_collection_amount"/></group><button name="action_wah_open_dispatch" type="object" string="Abrir panel de reparto y cobros" class="btn-primary"/></page></xpath></field></record>
 <record id="dispatch_preparation_entry" model="ir.ui.view"><field name="name">wah.preparation.dispatch.entry</field><field name="model">wah.preparation</field><field name="inherit_id" ref="wheelwright_ahorra.preparation_form"/><field name="arch" type="xml"><xpath expr="//button[@name='action_deliver']" position="replace"><button name="action_open_dispatch" type="object" string="Ver reparto y cobro" class="btn-primary"/></xpath></field></record>
</odoo>
