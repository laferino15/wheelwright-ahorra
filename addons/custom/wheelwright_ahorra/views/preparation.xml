<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="merchant_preparation_entry" inherit_id="wheelwright_ahorra.merchant_dashboard">
  <xpath expr="//div[hasclass('wah-merchant')]/div[1]" position="after"><div class="wah-merchant-form mt-4 d-flex flex-wrap align-items-center justify-content-between gap-3"><div><h3 class="mb-1">Pedidos para preparar</h3><p class="mb-0">Consultá lo que pidieron a tu local y avisá cuando esté listo.</p></div><a href="/mi-comercio/pedidos" class="btn btn-success">Ver pedidos de mi local</a></div></xpath>
 </template>
 <template id="merchant_preparations" name="Pedidos de mi local"><t t-call="portal.portal_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant py-4"><a href="/mi-comercio" class="wah-text-link">← Mi comercio</a><h1 class="mt-3">Pedidos para preparar</h1><p>Local: <strong t-esc="store.name"/>. Acá aparecen las compras confirmadas que incluyen tus productos.</p><nav class="d-flex gap-2 my-4" aria-label="Filtrar preparaciones"><a href="/mi-comercio/pedidos?status=open" t-attf-class="btn #{'btn-success' if status == 'open' else 'btn-outline-success'}">En curso</a><a href="/mi-comercio/pedidos?status=closed" t-attf-class="btn #{'btn-success' if status == 'closed' else 'btn-outline-success'}">Finalizados</a><a href="/mi-comercio/pedidos?status=all" t-attf-class="btn #{'btn-success' if status == 'all' else 'btn-outline-success'}">Todos</a></nav><div t-if="not preparations" class="wah-merchant-form"><h3>No hay pedidos en esta sección</h3><p>Cuando se confirme una compra a tu local, aparecerá acá. Actualizá la página para consultar novedades.</p></div><div t-else="" class="table-responsive"><table class="table align-middle"><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th>Subtotal de mi local</th><th/></tr></thead><tbody><tr t-foreach="preparations" t-as="preparation"><td><strong t-field="preparation.reference"/></td><td><span t-field="preparation.placed_at"/></td><td><span class="badge bg-secondary" t-att-data-state="preparation.state" t-field="preparation.state"/></td><td><span t-field="preparation.amount_total"/></td><td><a t-att-href="'/mi-comercio/pedidos/%s' % preparation.id" class="btn btn-outline-success btn-sm">Ver preparación</a></td></tr></tbody></table></div><t t-call="portal.pager"/></div></t></template>
 <template id="merchant_preparation_detail" name="Preparación del pedido"><t t-call="portal.portal_layout"><t t-set="no_breadcrumbs" t-value="True"/><div class="container wah-merchant py-4"><a href="/mi-comercio/pedidos" class="wah-text-link">← Pedidos de mi local</a><div class="d-flex flex-wrap justify-content-between gap-3 align-items-center mt-3 mb-4"><div><h1>Pedido <t t-esc="preparation.reference"/></h1><p class="mb-1" t-esc="preparation.store_name"/><small t-field="preparation.placed_at"/></div><span class="badge bg-secondary" t-att-data-state="preparation.state" t-field="preparation.state"/></div><div t-if="updated" class="alert alert-success" role="status">La preparación se actualizó correctamente.</div><div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/><div t-if="preparation.state == 'cancelled'" class="alert alert-warning">Este pedido fue cancelado. No prepares ni entregues estos productos.</div><div class="wah-merchant-form"><h2>Productos de tu local</h2><div class="table-responsive"><table class="table"><thead><tr><th>Producto / presentación</th><th>Cantidad</th><th>Subtotal</th></tr></thead><tbody><tr t-foreach="preparation.line_ids" t-as="line"><td class="text-prewrap"><span t-field="line.name"/></td><td><strong t-field="line.quantity"/> <span t-field="line.uom_name"/></td><td><span t-field="line.amount_total"/></td></tr></tbody></table></div><p class="text-end">Subtotal de este local, con impuestos: <strong t-field="preparation.amount_total"/></p><p class="small text-muted">El reparto y el cobro los coordina wheel-ahorra. Este importe no es una liquidación de comisiones ni confirma que el pedido esté pagado.</p>
  <form t-if="preparation.state in ('received','preparing')" method="post" t-att-action="'/mi-comercio/pedidos/%s/actualizar' % preparation.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button t-if="preparation.state == 'received'" type="submit" name="action" value="start" class="btn btn-success">Comenzar preparación</button><button t-else="" type="submit" name="action" value="ready" class="btn btn-success">Marcar listo para retirar</button></form><p t-if="preparation.state == 'ready'" class="alert alert-success mt-3">Aviso registrado: tu pedido está listo para retirar. La administración coordina el retiro.</p><p t-if="preparation.state in ('collected','delivered')" class="alert alert-info mt-3">La administración registró el retiro de estos productos.</p></div>
  <form t-if="preparation.state not in ('cancelled','delivered')" class="wah-merchant-form mt-4" method="post" t-att-action="'/mi-comercio/pedidos/%s/actualizar' % preparation.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="note"/><label for="merchant_note" class="form-label">Observación para la administración</label><textarea id="merchant_note" name="merchant_note" rows="3" maxlength="1000" class="form-control" placeholder="Por ejemplo: un faltante o una indicación para el retiro"><t t-esc="preparation.merchant_note or ''"/></textarea><button type="submit" class="btn btn-outline-success mt-3">Guardar observación</button></form><div t-elif="preparation.merchant_note" class="wah-merchant-form mt-4"><h3>Observación del local</h3><p class="text-prewrap" t-esc="preparation.merchant_note"/></div>
 </div></t></template>
 <record id="preparation_list" model="ir.ui.view"><field name="name">wah.preparation.list</field><field name="model">wah.preparation</field><field name="arch" type="xml"><list create="0" delete="0" decoration-warning="not merchant_id" decoration-success="state == 'ready'"><field name="reference"/><field name="store_name"/><field name="merchant_id"/><field name="placed_at"/><field name="currency_id" column_invisible="1"/><field name="amount_total"/><field name="state"/><field name="merchant_note" optional="show"/></list></field></record>
 <record id="preparation_form" model="ir.ui.view"><field name="name">wah.preparation.form</field><field name="model">wah.preparation</field><field name="arch" type="xml"><form create="0" delete="0" edit="0"><header><button name="action_start" type="object" string="En preparación" invisible="state != 'received'"/><button name="action_ready" type="object" string="Listo para retirar" invisible="state != 'preparing'"/><button name="action_collect" type="object" string="Registrar retiro" class="btn-primary" invisible="state != 'ready'"/><button name="action_deliver" type="object" string="Registrar entrega" class="btn-primary" invisible="state != 'collected'"/><field name="state" widget="statusbar"/></header><sheet><div class="alert alert-warning" role="status" invisible="merchant_id">Este local no tiene un dueño registrado asociado. La administración debe coordinar esta preparación manualmente.</div><group><group><field name="reference"/><field name="order_id"/><field name="merchant_id"/><field name="store_name"/><field name="placed_at"/></group><group><field name="started_at"/><field name="ready_at"/><field name="collected_at"/><field name="delivered_at"/></group></group><field name="line_ids"><list create="0" delete="0"><field name="name"/><field name="quantity"/><field name="uom_name"/><field name="currency_id" column_invisible="1"/><field name="amount_total"/></list></field><group><field name="currency_id" invisible="1"/><field name="amount_total"/><field name="merchant_note"/></group><p class="text-muted">Retirar o entregar no registra un pago. El cobro se gestiona por separado en Odoo.</p></sheet></form></field></record>
 <record id="preparation_search" model="ir.ui.view"><field name="name">wah.preparation.search</field><field name="model">wah.preparation</field><field name="arch" type="xml"><search><field name="reference"/><field name="store_name"/><field name="merchant_id"/><filter name="active_preparations" string="En curso" domain="[('state','not in',['delivered','cancelled'])]"/><filter name="ready_preparations" string="Listos para retirar" domain="[('state','=','ready')]"/><filter name="unassigned" string="Sin dueño asignado" domain="[('merchant_id','=',False)]"/><group><filter name="by_merchant" string="Comercio" context="{'group_by':'merchant_id'}"/><filter name="by_state" string="Estado" context="{'group_by':'state'}"/></group></search></field></record>
 <record id="preparation_action" model="ir.actions.act_window"><field name="name">Preparaciones y reparto</field><field name="res_model">wah.preparation</field><field name="view_mode">list,form</field><field name="context">{'search_default_active_preparations':1}</field></record>
 <menuitem id="preparation_menu" parent="marketplace_menu" name="Preparaciones y reparto" action="preparation_action" sequence="30"/>
 <record id="order_preparations_backend" model="ir.ui.view"><field name="name">sale.order.wah.preparations</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Seguimiento de preparación" invisible="not website_id"><group><field name="wah_preparation_state"/><field name="wah_unassigned_count"/></group><button name="action_wah_generate_preparations" type="object" string="Generar preparaciones faltantes" invisible="state != 'sale'"/><field name="wah_preparation_ids" readonly="1"><list><field name="store_name"/><field name="merchant_id"/><field name="state"/><field name="ready_at"/><field name="collected_at"/><field name="delivered_at"/></list></field></page></xpath></field></record>
 <template id="buyer_preparation_state" inherit_id="sale.sale_order_portal_content"><xpath expr="//div[@id='introduction']" position="after"><div t-if="sale_order.website_id and sale_order.state == 'sale'" class="alert alert-info my-3"><strong>Estado de tu pedido: </strong><span t-field="sale_order.wah_preparation_state"/></div></xpath></template>
</odoo>
